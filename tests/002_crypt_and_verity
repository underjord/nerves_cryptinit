# Encrypted AND integrity-verified rootfs — the full stack:
# flash -> dm-crypt -> dm-verity -> squashfs. dm-crypt decrypts the flash
# partition into /dev/dm-0; dm-verity verifies that decrypted view (so the
# hash tree, co-located on /dev/dm-0, is encrypted on flash) into /dev/dm-1,
# which is what we mount.

cat > "$CMDLINE_FILE" <<'EOF'
root=/dev/mmcblk0p2 rootfstype=squashfs ro init=/sbin/init verity_roothash=deadbeef00112233
EOF

mkdir -p "$WORK_DIR/etc"
cat > "$CONFIG" <<'EOF'
rootfs_key = hex:00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
EOF

# Encrypted source device (512KB → 1024 blocks of 512 bytes for dm-crypt's
# block-count math). /dev/mapper/control just needs to be openable.
dd if=/dev/zero of="$WORK_DIR/dev/mmcblk0p2" bs=512 count=1024 2>/dev/null
mkdir -p "$WORK_DIR/dev/mapper"
touch "$WORK_DIR/dev/mapper/control"

# The decrypted view that dm-crypt would produce. The fixture fakes the
# crypt ioctls, so we stage /dev/dm-0 directly with the squashfs superblock
# (sizes the filesystem -> hash offset 32768) and the verity superblock that
# init reads through to build the verity table.
stage_verity_device "$WORK_DIR/dev/dm-0" 32768 8
stage_squashfs_header "$WORK_DIR/dev/dm-0" 32768

mkdir -p "$WORK_DIR/mnt/sbin"
cat > "$WORK_DIR/mnt/sbin/init" <<'EOF'
#!/bin/sh
echo "Hello from /sbin/init"
EOF
chmod +x "$WORK_DIR/mnt/sbin/init"

