# Encrypted + verified rootfs AND an encrypted data partition. The rootfs
# is the full flash -> dm-crypt -> dm-verity -> squashfs stack (dm-0 crypt,
# dm-1 verity); the data partition is set up after switch_root, so the
# fixture's path rerouting moves to /mnt-based paths.

cat > "$CMDLINE_FILE" <<'EOF'
root=/dev/mmcblk0p2 rootfstype=squashfs ro init=/sbin/init verity_roothash=deadbeef00112233
EOF

mkdir -p "$WORK_DIR/etc"
cat > "$CONFIG" <<'EOF'
rootfs_key = hex:00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
data_device = /dev/mmcblk0p3
data_key = hex:ffeeddccbbaa99887766554433221100ffeeddccbbaa99887766554433221100
EOF

# Source devices and dm-control before switch_root.
dd if=/dev/zero of="$WORK_DIR/dev/mmcblk0p2" bs=512 count=1024 2>/dev/null
mkdir -p "$WORK_DIR/dev/mapper"
touch "$WORK_DIR/dev/mapper/control"

# Decrypted rootfs view (dm-0) carrying the squashfs + verity superblocks.
stage_verity_device "$WORK_DIR/dev/dm-0" 32768 8
stage_squashfs_header "$WORK_DIR/dev/dm-0" 32768

# After switch_root, paths are looked up under /mnt/.
mkdir -p "$WORK_DIR/mnt/dev/mapper"
touch "$WORK_DIR/mnt/dev/mapper/control"
dd if=/dev/zero of="$WORK_DIR/mnt/dev/mmcblk0p3" bs=512 count=1024 2>/dev/null

mkdir -p "$WORK_DIR/mnt/sbin"
cat > "$WORK_DIR/mnt/sbin/init" <<'EOF'
#!/bin/sh
echo "Hello from /sbin/init"
EOF
chmod +x "$WORK_DIR/mnt/sbin/init"

